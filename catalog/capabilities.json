{
  "format_version": 1,
  "workspace": "vbot-docs",
  "supported_target": {
    "robot_type": "foot_quadruped",
    "application_version": "V1.6.0",
    "sdk_release": "edu-sdk-2026.9.24",
    "middleware": "Aorta (Zenoh) + ROS 2 Humble Bridge"
  },
  "capabilities": [
    {
      "id": "device.edu_overview",
      "module": "01-getting-started",
      "summary": "掌握 VBOT 大头 EDU 版产品全景、地瓜 S100P 128TOPS 算力、14 关节电机、双脑硬件规格、市面消费级 / 大头消费版 / 大头 EDU 三方六维区别（EDU 的 vbot 为普通用户，1.6 固件未开放 root/sudo）与官方发布视频核心场景剖析",
      "interface_kind": "product_overview",
      "reference_doc": "01-getting-started/1.0-vbot-edu-overview.md",
      "safety_level": "informational"
    },
    {
      "id": "device.network.connect",
      "module": "01-getting-started",
      "summary": "通过 Type-C 扩展网口 (192.168.126.100) 或 1.6 板载 WiFi 直连接入机器人并配置 SSH 免密",
      "interface_kind": "network_ssh",
      "target_ip": "192.168.126.2",
      "reference_doc": "01-getting-started/1.1-unboxing-and-network.md",
      "safety_level": "read_only"
    },
    {
      "id": "locomotion.vel_cmd.basic",
      "module": "01-getting-started",
      "summary": "向 /vel_cmd 发布 20Hz 连续速度控制报文，驱动机器狗行走与转向（带看门狗与急停兜底）",
      "interface_kind": "ros2_topic",
      "topic_name": "/vel_cmd",
      "message_type": "geometry_msgs/msg/Twist",
      "frequency_hz": 20,
      "reference_doc": "01-getting-started/1.2-hello-world-motion.md",
      "safety_level": "motion_control",
      "requires_flag": "--confirm-motion"
    },
    {
      "id": "system.architecture.dual_brain",
      "module": "02-architecture-comm",
      "summary": "掌握 192.168.126.2 计算主板 (大脑皮层) 与 192.168.127.10 网关板 (神经系统) 分工及物理路由",
      "interface_kind": "architecture_spec",
      "reference_doc": "02-architecture-comm/2.1-dual-brain-architecture.md",
      "safety_level": "informational"
    },
    {
      "id": "comm.middleware.zenoh_ros2",
      "module": "02-architecture-comm",
      "summary": "Aorta (Zenoh 46 核心话题) 主干道与 ROS 2 本地桥接 (Domain 178) 破壁",
      "interface_kind": "middleware_config",
      "domain_id": 178,
      "reference_doc": "02-architecture-comm/2.2-zenoh-and-ros2-bridge.md",
      "safety_level": "informational"
    },
    {
      "id": "dev.environment.recipes_common",
      "module": "02-architecture-comm",
      "summary": "DevContainer 容器构建、端到端五步部署法、Bazel 离线编译与 recipes/common.py 生产级代码骨架",
      "interface_kind": "dev_tooling",
      "reference_doc": "02-architecture-comm/2.3-dev-environment-setup.md",
      "safety_level": "read_only"
    },
    {
      "id": "motion.rcp.dag_execution",
      "module": "03-embodied-agent",
      "summary": "RCP Action 动作流编排与 DAG 图执行，支持声光屏与运动安全并发，严格遵守互斥准则",
      "interface_kind": "aorta_action",
      "action_name": "/rcp/execute_task",
      "resource_locks": ["LEGS", "HEAD", "SCREEN", "LIGHT", "AUDIO_OUT"],
      "reference_doc": "03-embodied-agent/3.1-motion-control-and-rcp.md",
      "safety_level": "motion_control"
    },
    {
      "id": "perception.sensors.stream",
      "module": "03-embodied-agent",
      "summary": "360° 16 线激光雷达点云降维切片、双目相机 H.265 硬件视频流实时解码与 17 点骨骼 Logit 转换",
      "interface_kind": "perception_stream",
      "reference_doc": "03-embodied-agent/3.2-perception-data-streams.md",
      "safety_level": "read_only"
    },
    {
      "id": "agent.multimodal.mcp_service",
      "module": "03-embodied-agent",
      "summary": "多模态大模型接入、离线语音截流与设备端 18080 HTTP MCP 工具服务挂载 (FastAPI JSON-RPC)",
      "interface_kind": "http_mcp",
      "endpoint": "http://192.168.127.2:18080/mcp",
      "reference_doc": "03-embodied-agent/3.3-ai-native-multimodal.md",
      "safety_level": "agent_extension"
    },
    {
      "id": "hardware.specs.constraints",
      "module": "04-hardware-recipes",
      "summary": "16kg 机身规格、594Wh 电源约束、5kg 额定/12kg 极限负重边界与 CPU 亲和性隔离 (taskset -c 2-7)",
      "interface_kind": "hardware_spec",
      "rated_payload_kg": 5.0,
      "max_payload_kg": 12.0,
      "reference_doc": "04-hardware-recipes/4.1-specs-and-constraints.md",
      "safety_level": "hardware_engineering"
    },
    {
      "id": "hardware.modifications.arm",
      "module": "04-hardware-recipes",
      "summary": "背板机械接口打孔规范 (PETG/PA-CF)、CAN 总线扩展 (1Mbps) 与 PiPER 六轴机械臂集成规约",
      "interface_kind": "hardware_spec",
      "reference_doc": "04-hardware-recipes/4.2-hardware-modifications.md",
      "safety_level": "hardware_engineering"
    },
    {
      "id": "cases.hackathon.blueprints",
      "module": "04-hardware-recipes",
      "summary": "SheNicest 6 大得奖项目工程架构与完整复盘（LinBot 陪诊、YogaGo 瑜伽搭子、牛来芭比、PoopSense 等）",
      "interface_kind": "casebook",
      "reference_doc": "04-hardware-recipes/4.3-hackathon-blueprints.md",
      "safety_level": "informational"
    },
    {
      "id": "diagnostics.four_layers",
      "module": "05-diagnostics-faq",
      "summary": "自底向上的物理层、网络层、中间件层与应用层四层隔离诊断排查法与 15+ 极速 FAQ",
      "interface_kind": "troubleshooting",
      "reference_doc": "05-diagnostics-faq/5.1-four-layer-diagnostics.md",
      "safety_level": "read_only"
    },
    {
      "id": "safety.guardrails.watchdog",
      "module": "05-diagnostics-faq",
      "summary": "机器人工程安全三大交通规则、0.5s 看门狗、物理硬件急停与带 flock 文件锁的生产自启动脚本",
      "interface_kind": "safety_spec",
      "reference_doc": "05-diagnostics-faq/5.2-safety-and-guardrails.md",
      "safety_level": "safety_critical"
    }
  ]
}
